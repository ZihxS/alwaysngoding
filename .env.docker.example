# Optional overrides for the local Docker setup.
# Copy to .env.docker, then use make docker-up or:
# docker compose --env-file .env.docker up -d --build --wait
DOCKER_APP_PORT=8080
DOCKER_SOCKET_PORT=1315
DOCKER_DB_DATABASE=alwaysngoding
DOCKER_DB_USERNAME=alwaysngoding
DOCKER_DB_PASSWORD=local-development-password
DOCKER_DB_ROOT_PASSWORD=local-development-root-password
DOCKER_DB_PREFIX=app_
# Blank generates a random key stored in the app-state Docker volume.
DOCKER_APP_ENCRYPTION_KEY=

# Optional integrations. Missing or incomplete settings hide the related actions.
GCAPTCHA=no
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_LANG=id
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SNAP_URL=
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Always Ngoding"
DISCORD_WEBHOOK_URL=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
GLOT_API_TOKEN=
