CI_ENV=development
# Keep development deprecations visible; Docker overrides this for the legacy runtime.
APP_SHOW_DEPRECATIONS=true
APP_URL=http://localhost:8888/your-app
ANG_SOCKET_URL=http://localhost:1315
ANG_SOCKET_TRANSPORT_POLLING_URL=http://localhost:1315
SOCKET_ALLOWED_ORIGINS=http://localhost:8888
SOCKET_MAX_HTTP_BUFFER_SIZE=1000000
CONSOLE_CLEAR=show
CACHE_ASSET_VERSIONING=20260922
SITEMAP_LASTMOD=2026-09-22T00:00:00+07:00
KOMPRES=no
GCAPTCHA=no

# Development database: use a local account with minimum privileges.
DEV_DB_HOSTNAME=127.0.0.1
DEV_DB_PORT=3306
DEV_DB_DATABASE=your_app_dev
DEV_DB_USERNAME=your_app_dev
DEV_DB_PASSWORD=change-me
DEV_DB_DBPREFIX=app_

# Production database: set these only in the deployment secret store.
DB_HOSTNAME=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_app
DB_USERNAME=your_app
DB_PASSWORD=change-me
DB_DBPREFIX=app_

APP_ENCRYPTION_KEY=generate-a-long-random-secret
SESSION_COOKIE_NAME=app_session
CSRF_TOKEN_NAME=csrf_token
CSRF_COOKIE_NAME=csrf_cookie
COOKIE_SECURE=false
COOKIE_HTTPONLY=true

# Optional integrations stay disabled until their required settings are complete.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_LANG=id

MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# Blank selects the sandbox/production script from MIDTRANS_IS_PRODUCTION.
MIDTRANS_SNAP_URL=

# Optional SMTP. Disabled until explicitly enabled with valid local settings.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=
SMTP_PASSWORD=
# tls = STARTTLS, ssl = implicit TLS, blank = local unencrypted mail catcher.
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Always Ngoding"

# Optional, server-side only. Leave blank to disable Discord notifications.
DISCORD_WEBHOOK_URL=

TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# Remote PHP/Javascript exercise execution. Leave blank to hide the run button.
GLOT_API_TOKEN=
